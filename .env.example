# Backend URL for the server (sign-in, session refresh and the /api/backend proxy), including /api/v1.
# Required: without it, sign-in fails with "Could not reach the Trukkas backend".
API_BASE_URL=https://trukkas-backend.onrender.com/api/v1

# Public API base URL, including /api/v1. Set this when building the static site.
NEXT_PUBLIC_API_BASE_URL=https://trukkas-backend.onrender.com/api/v1

# API request/response logging is enabled in development by default. Set false to turn it off.
# Production builds always disable API logging.
NEXT_PUBLIC_API_LOGGING=true

# Browser-restricted Google Maps JavaScript API key. Enable billing and allow your frontend origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
